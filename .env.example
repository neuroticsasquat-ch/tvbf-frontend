# Copy to .env.local and adjust as needed. .env.local is gitignored.
VITE_API_BASE_URL=https://tvbf-backend.localhost
# Cloudflare Turnstile's public site key (NEU-1166). Leave blank to render no
# verification widget, which is the right default locally: the backend ships with
# TURNSTILE_ENABLED=False and nothing in either repo turns it on, so a signup form
# demanding a challenge would only make localdev signup impossible. Production sets
# it in the Worker's build environment (Workers Builds).
# VITE_TURNSTILE_SITE_KEY=<your-turnstile-site-key>
# VITE_SENTRY_DSN=<your-tvbf-frontend-Bugsink-DSN>

# --- Production build only (set in the build environment, not .env.local) ---
# When SENTRY_AUTH_TOKEN is set, the Vite build uploads source maps to Bugsink and
# deletes them from the output. Unset (local/dev) builds skip this step entirely.
# None of these is VITE_-prefixed, so none reaches the client bundle.
# SENTRY_URL=https://<bugsink-host>
# SENTRY_AUTH_TOKEN=<bugsink-auth-token>
# SENTRY_ORG=bugsinkhasnoorgs
# SENTRY_PROJECT=tvbf-frontend
# The release is the commit SHA, read from VITE_GIT_SHA, WORKERS_CI_COMMIT_SHA,
# CF_PAGES_COMMIT_SHA or SOURCE_COMMIT, whichever the build environment sets.
